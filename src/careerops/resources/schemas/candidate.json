{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "role_packs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "clearances": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "search_policy": {
      "type": "object",
      "properties": {
        "work_modes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "remote",
              "hybrid",
              "onsite"
            ]
          }
        },
        "locations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "minimum_salary": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "minLength": 1
        },
        "apply_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "maybe_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "minimum_requirement_coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "work_modes",
        "locations",
        "minimum_salary",
        "currency",
        "apply_threshold",
        "maybe_threshold",
        "minimum_requirement_coverage"
      ],
      "additionalProperties": false
    },
    "hard_exclusions": {
      "type": "object",
      "properties": {
        "companies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "terms": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "require_known_salary": {
          "type": "boolean"
        }
      },
      "required": [
        "companies",
        "terms",
        "require_known_salary"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "id",
    "display_name",
    "role_packs",
    "skills",
    "clearances",
    "search_policy",
    "hard_exclusions"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
