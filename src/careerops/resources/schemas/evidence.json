{
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "kind": {
        "enum": [
          "achievement",
          "project",
          "skill",
          "architecture"
        ]
      },
      "summary": {
        "type": "string",
        "minLength": 1
      },
      "skills": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "capabilities": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "metrics": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "name",
            "value",
            "unit",
            "context"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "type": "number"
            },
            "unit": {
              "type": "string",
              "minLength": 1
            },
            "context": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "level": {
        "type": "integer",
        "minimum": 1,
        "maximum": 5
      },
      "verified": {
        "type": "boolean"
      },
      "source": {
        "type": "string",
        "minLength": 1
      }
    },
    "required": [
      "id",
      "kind",
      "summary",
      "skills",
      "capabilities",
      "metrics",
      "level",
      "verified",
      "source"
    ],
    "additionalProperties": false
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
